{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "local_scan"
    },
    "path": {
      "type": "string"
    },
    "outcome": {
      "enum": [
        "clean",
        "flagged",
        "unavailable",
        "error",
        "oversized",
        "unreadable",
        "not_regular",
        "changed"
      ]
    },
    "sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "size": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "ruleset_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence": {
      "$ref": "evidence.schema.json"
    },
    "exit_code": {
      "type": "integer"
    },
    "export": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "path",
    "outcome",
    "sha256",
    "size",
    "ruleset_id",
    "evidence",
    "exit_code"
  ],
  "additionalProperties": false
}
